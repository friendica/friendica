includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - .phpstan-baseline.neon

parameters:
    level: 4

    phpVersion: 80200 # PHP 8.2

    paths:
        - bin/auth_ejabberd.php
        - bin/console.php
        - bin/daemon.php
        - bin/jetstream.php
        - bin/worker.php
        - index.php
        - src/
        - static/
        - tests/

    scanDirectories:
        - mod
        - static
        - vendor
        - view

    excludePaths:
        - vendor/rector/

    dynamicConstantNames:
        - DB_UPDATE_VERSION

    treatPhpDocTypesAsCertain: false

    # See all rules at https://github.com/phpstan/phpstan-strict-rules/blob/2.0.x/rules.neon
    strictRules:
        allRules: false

    ignoreErrors:
        -
            message: '#^Call to an undefined method Mockery[\\\\](?:ExpectationInterface(?:[|]Mockery[\\\\]HigherOrderMessage)?|LegacyMockInterface)::(?:with|once|times|twice|withAnyArgs|andReturnUsing|addRules)\(\)\.$#'
            identifier: method.notFound
            path: tests/
            count: 247
