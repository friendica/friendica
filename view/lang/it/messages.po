"listed at %s/servers."
msgstr "Per server pubblici: puoi aggiungere informazioni extra che verranno mostrate su %s/servers."

#: src/Module/Admin/Site.php:490
msgid "System language"
msgstr "Lingua di sistema"

#: src/Module/Admin/Site.php:491
