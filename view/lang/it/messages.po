msgstr "Collegamento ad un'icona che verrà usata dai tablet e i telefonini."

#: src/Module/Admin/Site.php:489
msgid "Additional Info"
msgstr "Informazioni aggiuntive"

#: src/Module/Admin/Site.php:489
