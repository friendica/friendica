#: src/Module/Moderation/Report/Create.php:200
msgid "Contact address/URL"
msgstr "Kontakts adresse/URL"

#: src/Module/Moderation/Report/Create.php:210
msgid "Pick Category"
msgstr "Vælg Kategori"

#: src/Module/Moderation/Report/Create.php:211
msgid "Please pick below the category of your report."
msgstr "Vælg venligst kategorien for din anmeldelse herunder."

#: src/Module/Moderation/Report/Create.php:215
#: src/Module/Moderation/Reports.php:581 src/Module/Moderation/Reports.php:592
#: src/Module/Moderation/Utils/ReportUtil.php:20
msgid "Spam"
msgstr "Spam"

#: src/Module/Moderation/Report/Create.php:215
msgid ""
"This contact is publishing many repeated/overly long posts/replies or "
"advertising their product/websites in otherwise irrelevant conversations."
msgstr "Denne kontakt offentliggører mange gentagne/for lange opslag/svar eller reklamerer for deres produkt/hjemmeside i ellers irrelevante samtaler."

#: src/Module/Moderation/Report/Create.php:216
#: src/Module/Moderation/Reports.php:582 src/Module/Moderation/Reports.php:593
#: src/Module/Moderation/Utils/ReportUtil.php:21
msgid "Illegal Content"
msgstr "Illegalt Indhold"

#: src/Module/Moderation/Report/Create.php:216
msgid ""
"This contact is publishing content that is considered illegal in this node's"
" hosting juridiction."
msgstr "Denne kontakt publicerer indhold som anses for ulovligt hvor denne instans har hjemme."

#: src/Module/Moderation/Report/Create.php:217
#: src/Module/Moderation/Utils/ReportUtil.php:22
msgid "Community Safety"
msgstr "Fællesskabssikkerhed"

#: src/Module/Moderation/Report/Create.php:217
msgid ""
"This contact aggravated you or other people, by being provocative or "
"insensitive, intentionally or not. This includes disclosing people's private"
" information (doxxing), posting threats or offensive pictures in posts or "
"replies."
msgstr "Kontakten var provokerende eller ufølsom, enten intentionelt eller ikke. Dette inkluderer at afsløre folks private information (doxxing), trusler eller provokerende billeder i opslag eller kommentarer."

#: src/Module/Moderation/Report/Create.php:218
#: src/Module/Moderation/Utils/ReportUtil.php:23
msgid "Unwanted Content/Behavior"
msgstr "Uønsket indhold/opførsel"

#: src/Module/Moderation/Report/Create.php:218
msgid ""
"This contact has repeatedly published content irrelevant to the node's theme"
" or is openly criticizing the node's administration/moderation without "
"directly engaging with the relevant people for example or repeatedly "
"nitpicking on a sensitive topic."
msgstr "Denne kontakt har kontinuerligt delt indhold der er irrelevant ift. temaet på denne instans, eller det kritiserer denne instans' administration/moderation uden direkte at kommunikere med de relevante personer for eksempel, eller pendantisk opføsel omkring et følsomt emne."

#: src/Module/Moderation/Report/Create.php:219
#: src/Module/Moderation/Reports.php:583 src/Module/Moderation/Reports.php:594
#: src/Module/Moderation/Utils/ReportUtil.php:24
msgid "Rules Violation"
msgstr "Regelbrud"

#: src/Module/Moderation/Report/Create.php:219
msgid ""
"This contact violated one or more rules of this node. You will be able to "
"pick which one(s) in the next step."
msgstr "Kontakten brød en eller flere af reglerne på denne instans. Du vil kunne vælge hvilke(n) i næste trin."

#: src/Module/Moderation/Report/Create.php:220
msgid ""
"Please elaborate below why you submitted this report. The more details you "
"provide, the better your report can be handled."
msgstr "Uddyb venligst herunder, hvorfor du laver denne anmeldelse. Flere detaljer vil hjælpe moderatorerne med at håndtere det."

#: src/Module/Moderation/Report/Create.php:222
msgid "Additional Information"
msgstr "Yderligere information"

#: src/Module/Moderation/Report/Create.php:222
msgid ""
"Please provide any additional information relevant to this particular "
"report. You will be able to attach posts by this contact in the next step, "
"but any context is welcome."
msgstr "Giv venligst yderligere information der er relevant ift. denne anmeldelse. Du vil være i stand til at vedhæfte opslag fra denne kontakt i næste trin, men al kontekst er velkommen."

#: src/Module/Moderation/Report/Create.php:238
msgid "Pick Rules"
msgstr "Vælg regler"

#: src/Module/Moderation/Report/Create.php:239
msgid "Please pick below the node rules you believe this contact violated."
msgstr "Vælg venligst herunder hvilke regler, du mener kontakten har overtrådt."

#: src/Module/Moderation/Report/Create.php:296
msgid "Pick Posts"
msgstr "Vælg opslag"

#: src/Module/Moderation/Report/Create.php:297
msgid "Please optionally pick posts to attach to your report."
msgstr "Vælg venligst valgfrit opslag til at tilknytte til din anmeldelse."

#: src/Module/Moderation/Report/Create.php:313
msgid "Would you like to forward this report to the remote server?"
msgstr "Ønsker du at videresende denne anmeldelse til fjernserveren?"

#: src/Module/Moderation/Report/Create.php:315
msgid "Would you ike to forward this report to the remote server?"
msgstr "Ønsker du at videresende denne anmeldelse til den eksterne server?"

#: src/Module/Moderation/Report/Create.php:321
msgid "Submit Report"
msgstr "Indsend anmeldelse"

#: src/Module/Moderation/Report/Create.php:322
msgid "Further Action"
msgstr "Yderligere handling"

#: src/Module/Moderation/Report/Create.php:323
msgid ""
"You can also perform one of the following action on the contact you "
"reported:"
msgstr "Du kan også eksekvere en af følgende handlinger på den kontakt, du har anmeldt:"

#: src/Module/Moderation/Report/Create.php:332
msgid "Nothing"
msgstr "Intet"

#: src/Module/Moderation/Report/Create.php:333
msgid "Collapse contact"
msgstr "Sammenfold kontakt"

#: src/Module/Moderation/Report/Create.php:333
msgid ""
"Their posts and replies will keep appearing in your Network page but their "
"content will be collapsed by default."
msgstr "Deres opslag og svar vil fortsætte med at blive vis på din Netværksside, men deres indhold vil være sammenfoldet som standard."

#: src/Module/Moderation/Report/Create.php:334
msgid ""
"Their posts won't appear in your Network page anymore, but their replies can"
" appear in forum threads. They still can follow you."
msgstr "Deres opslag vil ikke blive vist på Netværkssiden længere, men deres svar kan blive vist i gruppe-tråde. De kan stadig følge dig."

#: src/Module/Moderation/Report/Create.php:335
msgid "Block contact"
msgstr "Blokér kontakt"

#: src/Module/Moderation/Report/Create.php:335
msgid ""
"Their posts won't appear in your Network page anymore, but their replies can"
" appear in forum threads, with their content collapsed by default. They "
"cannot follow you but still can have access to your public posts by other "
"means."
msgstr "Deres opslag vil ikke blive vist på Netværkssiden længere, men deres opslag kan blive vist i gruppe-tråde, med deres indhold kollapset som udgangspunkt. De kan ikke følge dig men kan stadig tilgå dine offentlige opslag på anden vis."

