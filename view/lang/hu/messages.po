msgstr "A Friendica jelenlegi „system.basepath” értéke („%s”) hibás, és a(z) „%s” beállítófájl nincs használva."

#: src/Module/Admin/Summary.php:160
#, php-format
msgid ""
"Friendica's current system.basepath '%s' is not equal to the config file "
