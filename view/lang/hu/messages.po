#: src/Module/Settings/TwoFactor/Verify.php:119
#, php-format
msgid ""
"<p>Or you can submit the authentication settings manually:</p>\n"
"<dl>\n"
"\t<dt>Issuer</dt>\n"
"\t<dd>%s</dd>\n"
"\t<dt>Account Name</dt>\n"
"\t<dd>%s</dd>\n"
"\t<dt>Secret Key</dt>\n"
"\t<dd>%s</dd>\n"
"\t<dt>Type</dt>\n"
