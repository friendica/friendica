msgstr "Tiedostonimi"

#: src/Module/Settings/Attachments.php:97
msgid "Size"
msgstr "Koko"

#: src/Module/Settings/Attachments.php:98
msgid "Uploaded"
msgstr "Lähetetty"

#: src/Module/Settings/Attachments.php:100
