REGISTRY_URL=cr.mj12.cloud
REGISTRY_USER=your-username
REGISTRY_PASSWORD=your-password

# Optional: push via SSH tunnel to bypass Cloudflare's upload size limit.
# 1. Open the tunnel:  ssh -L 5000:localhost:PORT user@your-server
#    (replace PORT with the port cr.mj12.cloud registry listens on internally)
# 2. Uncomment the line below — build.sh will push to localhost:5000
#    but the image is still tagged as cr.mj12.cloud/... in the registry.
#REGISTRY_PUSH_URL=localhost:5000
